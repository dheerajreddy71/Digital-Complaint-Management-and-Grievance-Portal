# Aiven MySQL Cloud Database Configuration
NODE_ENV=production
PORT=5000

# Aiven MySQL Database
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=16109
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_NAME=defaultdb

# JWT Secret (REPLACE WITH YOUR OWN IN PRODUCTION)
JWT_SECRET=your-production-jwt-secret-here-change-this-to-a-secure-random-string

# Cloudinary Configuration (if using file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Registration (set to false in production)
ADMIN_REGISTRATION_ENABLED=false
ADMIN_REGISTRATION_KEY=your-secure-admin-key-here

# CORS Origin (Vercel frontend URL)
CORS_ORIGIN=https://dcmgp.vercel.app
